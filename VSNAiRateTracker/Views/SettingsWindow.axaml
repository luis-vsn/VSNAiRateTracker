<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VSNAiRateTracker.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="680" d:DesignHeight="880"
        x:Class="VSNAiRateTracker.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="{Binding [App.Title]}"
        Width="680" Height="880"
        MinWidth="640" MinHeight="700"
        CanResize="True"
        WindowStartupLocation="CenterScreen">

    <Grid RowDefinitions="Auto,*,Auto" Margin="24">
        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,16">
            <TextBlock Text="{Binding [App.Title]}"
                       FontSize="20"
                       FontWeight="SemiBold" />
            <TextBlock Text="{Binding [Nav.AuthDesc]}"
                       FontSize="12"
                       Foreground="{DynamicResource SystemBaseMediumColor}" />
        </StackPanel>

        <!-- Form content -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="16" Margin="0,0,12,0">

                <!-- Section 0: Language Selection -->
                <Border BorderBrush="{DynamicResource SystemBaseLowColor}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding [Nav.Language]}" FontWeight="SemiBold" FontSize="13" />
                            <TextBlock Text="{Binding [Nav.LanguageDesc]}" FontSize="11" Foreground="{DynamicResource SystemBaseMediumColor}" />
                        </StackPanel>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding AvailableLanguages}"
                                  SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                                  MinWidth="140"
                                  VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Section 1: Anthropic Web Signing / OAuth -->
                <Border BorderBrush="{DynamicResource SystemAccentColor}"
                        BorderThickness="1.5"
                        CornerRadius="8"
                        Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{Binding [Auth.WebSection]}"
                                   FontWeight="SemiBold"
                                   FontSize="14" />

                        <TextBlock Text="{Binding [Auth.WebHelp]}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource SystemBaseMediumColor}" />

                        <!-- Current status label -->
                        <Border Background="{DynamicResource SystemBaseLowColor}"
                                CornerRadius="4"
                                Padding="10,8">
                            <TextBlock Text="{Binding SessionStatusText}"
                                       FontSize="12"
                                       FontWeight="Medium" />
                        </Border>

                        <!-- Action buttons with WrapPanel to prevent truncation -->
                        <WrapPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Button Content="{Binding [Auth.BtnSignIn]}"
                                    Classes="accent"
                                    Click="OnLoginWithWebClick"
                                    IsEnabled="{Binding !IsLoggingIn}"
                                    Margin="0,0,8,8" />

                            <Button Content="{Binding [Auth.BtnImport]}"
                                    Click="OnImportClaudeClick"
                                    IsEnabled="{Binding !IsLoggingIn}"
                                    Margin="0,0,8,8" />

                            <Button Content="{Binding [Auth.BtnSignOut]}"
                                    Click="OnLogoutWebClick"
                                    IsVisible="{Binding IsLoggedInWithWeb}"
                                    Margin="0,0,8,8" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Section 2: Alternative Manual API Key -->
                <Border BorderBrush="{DynamicResource SystemBaseLowColor}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{Binding [Auth.ManualSection]}"
                                   FontWeight="SemiBold"
                                   FontSize="13" />

                        <TextBlock Text="{Binding [Auth.ApiKeyPlaceholder]}"
                                   FontSize="11"
                                   Foreground="{DynamicResource SystemBaseMediumColor}" />

                        <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                            <TextBox Grid.Column="0"
                                     Text="{Binding ApiKey}"
                                     PasswordChar="*"
                                     PlaceholderText="sk-ant-..."
                                     VerticalAlignment="Center" />
                            <Button Grid.Column="1"
                                     Content="{Binding [Auth.BtnTest]}"
                                     Margin="8,0,0,0"
                                     Click="OnTestConnectionClick"
                                     IsEnabled="{Binding !IsTestingConnection}"
                                     VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock Text="{Binding StatusMessage}"
                                   FontSize="12"
                                   FontWeight="Medium"
                                   IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                </Border>

                <!-- Section 3: Working Schedule By Day -->
                <Border BorderBrush="{DynamicResource SystemBaseLowColor}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{Binding [Nav.Schedule]}"
                                   FontWeight="SemiBold"
                                   FontSize="14" />

                        <TextBlock Text="{Binding [Nav.ScheduleDesc]}"
                                   FontSize="11"
                                   Foreground="{DynamicResource SystemBaseMediumColor}" />

                        <ItemsControl ItemsSource="{Binding DaySchedules}" Margin="0,4,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="110,*,*" Margin="0,4">
                                        <CheckBox Grid.Column="0"
                                                  Content="{Binding DayName}"
                                                  IsChecked="{Binding IsEnabled}"
                                                  VerticalAlignment="Center"
                                                  FontWeight="Medium" />

                                        <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    Spacing="6"
                                                    IsEnabled="{Binding IsEnabled}"
                                                    Margin="4,0">
                                            <TextBlock Text="Entrada:"
                                                       FontSize="11"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource SystemBaseMediumColor}" />
                                            <TimePicker SelectedTime="{Binding StartTime}"
                                                        MinuteIncrement="15" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2"
                                                    Orientation="Horizontal"
                                                    Spacing="6"
                                                    IsEnabled="{Binding IsEnabled}"
                                                    Margin="4,0">
                                            <TextBlock Text="Salida:"
                                                       FontSize="11"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource SystemBaseMediumColor}" />
                                            <TimePicker SelectedTime="{Binding EndTime}"
                                                        MinuteIncrement="15" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Section 4: Rate Thresholds & Colors -->
                <Border BorderBrush="{DynamicResource SystemBaseLowColor}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{Binding [Nav.Thresholds]}"
                                   FontWeight="SemiBold"
                                   FontSize="14" />

                        <TextBlock Text="{Binding [Nav.ThresholdsDesc]}"
                                   FontSize="11"
                                   Foreground="{DynamicResource SystemBaseMediumColor}" />

                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" Margin="0,4,0,0">
                            <!-- Optimal threshold -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4" Margin="0,0,8,8">
                                <TextBlock Text="{Binding [Threshold.OptimalMargin]}" FontSize="11" FontWeight="Medium" />
                                <NumericUpDown Value="{Binding OptimalMarginHours}"
                                               Minimum="0.1"
                                               Maximum="5.0"
                                               Increment="0.1"
                                               FormatString="{}{0:0.0} h" />
                            </StackPanel>

                            <!-- Rush threshold -->
                            <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4" Margin="8,0,0,8">
                                <TextBlock Text="{Binding [Threshold.HighMargin]}" FontSize="11" FontWeight="Medium" />
                                <NumericUpDown Value="{Binding HighRateMarginHours}"
                                               Minimum="1.0"
                                               Maximum="20.0"
                                               Increment="0.5"
                                               FormatString="{}{0:0.0} h" />
                            </StackPanel>

                            <!-- Visual Color Pickers -->
                            <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="*,*,*,*" Margin="0,8,0,0">
                                <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,6,0">
                                    <TextBlock Text="Óptimo" FontSize="11" FontWeight="Medium" />
                                    <ColorPicker Color="{Binding ColorOptimal, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="4" Margin="3,0,3,0">
                                    <TextBlock Text="Acelerado" FontSize="11" FontWeight="Medium" />
                                    <ColorPicker Color="{Binding ColorWarningFast, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="4" Margin="3,0,3,0">
                                    <TextBlock Text="Excesivo" FontSize="11" FontWeight="Medium" />
                                    <ColorPicker Color="{Binding ColorDangerFast, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                                </StackPanel>
                                <StackPanel Grid.Column="3" Spacing="4" Margin="6,0,0,0">
                                    <TextBlock Text="Lento" FontSize="11" FontWeight="Medium" />
                                    <ColorPicker Color="{Binding ColorSlow, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Section 5: Telemetry & Grafana -->
                <Border BorderBrush="{DynamicResource SystemBaseLowColor}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{Binding [Nav.Telemetry]}"
                                   FontWeight="SemiBold"
                                   FontSize="14" />

                        <TextBlock Text="{Binding [Nav.TelemetryDesc]}"
                                   FontSize="11"
                                   Foreground="{DynamicResource SystemBaseMediumColor}" />

                        <CheckBox Content="{Binding [Telemetry.Enable]}"
                                  IsChecked="{Binding TelemetryEnabled}"
                                  FontWeight="Medium"
                                  Margin="0,2,0,0" />

                        <StackPanel Spacing="8" IsEnabled="{Binding TelemetryEnabled}" Margin="0,4,0,0">
                            <!-- Endpoint -->
                            <StackPanel Spacing="3">
                                <TextBlock Text="{Binding [Telemetry.Endpoint]}" FontSize="11" FontWeight="Medium" />
                                <TextBox Text="{Binding TelemetryEndpoint}"
                                         PlaceholderText="http://localhost:4318 o https://otlp-gateway-{region}.grafana.net/otlp" />
                                <TextBlock Text="ℹ️ Autoalojado (Collector / Alloy): http://localhost:4318 | Grafana Cloud: https://otlp-gateway-{region}.grafana.net/otlp"
                                           FontSize="10"
                                           Foreground="{DynamicResource SystemBaseMediumColor}" />
                            </StackPanel>

                            <StackPanel Spacing="3">
                                <TextBlock Text="{Binding [Telemetry.ServiceName]}" FontSize="11" FontWeight="Medium" />
                                <TextBox Text="{Binding TelemetryServiceName}"
                                         PlaceholderText="vsn-ai-rate-tracker" />
                            </StackPanel>

                            <!-- Headers -->
                            <StackPanel Spacing="3">
                                <TextBlock Text="{Binding [Telemetry.Headers]}" FontSize="11" FontWeight="Medium" />
                                <TextBox Text="{Binding TelemetryHeaders}"
                                         PasswordChar="*"
                                         PlaceholderText="Authorization=Basic &lt;base64(usuario:token)&gt;" />
                                <TextBlock Text="ℹ️ Dejar en blanco si el Collector local no requiere auth. En Grafana Cloud introduce Authorization=Basic &lt;base64&gt;"
                                           FontSize="10"
                                           Foreground="{DynamicResource SystemBaseMediumColor}" />
                            </StackPanel>

                            <!-- Machine name badge -->
                            <Border Background="{DynamicResource SystemBaseLowColor}" CornerRadius="4" Padding="10,6" Margin="0,4,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="🖥️" VerticalAlignment="Center" />
                                    <TextBlock Text="Nombre del equipo en métricas y trazas:" FontSize="11" Foreground="{DynamicResource SystemBaseMediumColor}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding MachineName}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Section 6: Sync Settings -->
                <Border BorderBrush="{DynamicResource SystemBaseLowColor}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{Binding [Auth.SyncInterval]}"
                                   FontWeight="SemiBold"
                                   FontSize="14" />

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Frecuencia de actualización" FontSize="12" FontWeight="Medium" />
                                <TextBlock Text="Tiempo entre consultas al estado de la cuota" FontSize="11" Foreground="{DynamicResource SystemBaseMediumColor}" />
                            </StackPanel>
                            <NumericUpDown Grid.Column="1"
                                           Value="{Binding SyncIntervalMinutes}"
                                           Minimum="1"
                                           Maximum="60"
                                           FormatString="{}{0:0} min"
                                           VerticalAlignment="Center"
                                           Width="120" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer Buttons -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" Margin="0,16,0,0">
            <Button Grid.Column="1"
                    Content="{Binding [Common.Cancel]}"
                    Width="100"
                    Margin="0,0,8,0"
                    Click="OnCancelClick" />
            <Button Grid.Column="2"
                    Content="{Binding [Common.Save]}"
                    Classes="accent"
                    Width="140"
                    Click="OnSaveClick" />
        </Grid>
    </Grid>
</Window>
