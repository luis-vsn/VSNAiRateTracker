<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VSNAiRateTracker.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="680" d:DesignHeight="840"
        x:Class="VSNAiRateTracker.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="VSNAiRateTracker - Configuración"
        Width="680" Height="840"
        MinWidth="640" MinHeight="700"
        CanResize="True"
        WindowStartupLocation="CenterScreen">

    <Grid RowDefinitions="Auto,*,Auto" Margin="24">
        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,16">
            <TextBlock Text="Configuración de VSNAiRateTracker"
                       FontSize="20"
                       FontWeight="SemiBold" />
            <TextBlock Text="Monitoriza en tiempo real tu consumo de cuota de Anthropic respecto a tu jornada laboral."
                       FontSize="12"
                       Foreground="{DynamicResource SystemBaseMediumColor}" />
        </StackPanel>

        <!-- Form content -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="16" Margin="0,0,12,0">
                <!-- Section 1: Anthropic Web Signing / OAuth -->
                <Border BorderBrush="{DynamicResource SystemAccentColor}"
                        BorderThickness="1.5"
                        CornerRadius="8"
                        Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Autenticación Web de Anthropic"
                                   FontWeight="SemiBold"
                                   FontSize="14" />

                        <TextBlock Text="Inicia sesión directamente con tu cuenta de Anthropic para obtener los tokens de acceso y renovación automática."
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource SystemBaseMediumColor}" />

                        <!-- Current status label -->
                        <Border Background="{DynamicResource SystemBaseLowColor}"
                                CornerRadius="4"
                                Padding="10,8">
                            <TextBlock Text="{Binding SessionStatusText}"
                                       FontSize="12"
                                       FontWeight="Medium" />
                        </Border>

                        <!-- Action buttons with WrapPanel to prevent truncation -->
                        <WrapPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Button Content="Iniciar sesión con Anthropic (Web)"
                                    Classes="accent"
                                    Click="OnLoginWithWebClick"
                                    IsEnabled="{Binding !IsLoggingIn}"
                                    Margin="0,0,8,8" />

                            <Button Content="Importar de Claude Code"
                                    Click="OnImportClaudeClick"
                                    IsEnabled="{Binding !IsLoggingIn}"
                                    Margin="0,0,8,8" />

                            <Button Content="Cerrar sesión"
                                    Click="OnLogoutWebClick"
                                    IsVisible="{Binding IsLoggedInWithWeb}"
                                    Margin="0,0,8,8" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Section 2: Alternative Manual API Key -->
                <Border BorderBrush="{DynamicResource SystemBaseLowColor}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Método alternativo: API Key estática"
                                   FontWeight="SemiBold"
                                   FontSize="13" />

                        <TextBlock Text="Si tu cuenta dispone de una API Key tradicional de Anthropic, puedes configurarla aquí."
                                   FontSize="11"
                                   Foreground="{DynamicResource SystemBaseMediumColor}" />

                        <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                            <TextBox Grid.Column="0"
                                     Text="{Binding ApiKey}"
                                     PasswordChar="*"
                                     PlaceholderText="sk-ant-..."
                                     VerticalAlignment="Center" />
                            <Button Grid.Column="1"
                                     Content="Probar Conexión"
                                     Margin="8,0,0,0"
                                     Click="OnTestConnectionClick"
                                     IsEnabled="{Binding !IsTestingConnection}"
                                     VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock Text="{Binding StatusMessage}"
                                   FontSize="12"
                                   FontWeight="Medium"
                                   IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                </Border>

                <!-- Section 3: Working Schedule By Day -->
                <Border BorderBrush="{DynamicResource SystemBaseLowColor}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Horario Laboral Semanal por Días"
                                   FontWeight="SemiBold"
                                   FontSize="14" />

                        <TextBlock Text="Configura de forma independiente cada día de la semana para reflejar tu jornada real."
                                   FontSize="11"
                                   Foreground="{DynamicResource SystemBaseMediumColor}" />

                        <ItemsControl ItemsSource="{Binding DaySchedules}" Margin="0,4,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="110,*,*" Margin="0,4">
                                        <CheckBox Grid.Column="0"
                                                  Content="{Binding DayName}"
                                                  IsChecked="{Binding IsEnabled}"
                                                  VerticalAlignment="Center"
                                                  FontWeight="Medium" />

                                        <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    Spacing="6"
                                                    IsEnabled="{Binding IsEnabled}"
                                                    Margin="4,0">
                                            <TextBlock Text="Entrada:"
                                                       FontSize="11"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource SystemBaseMediumColor}" />
                                            <TimePicker SelectedTime="{Binding StartTime}"
                                                        MinuteIncrement="15" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2"
                                                    Orientation="Horizontal"
                                                    Spacing="6"
                                                    IsEnabled="{Binding IsEnabled}"
                                                    Margin="4,0">
                                            <TextBlock Text="Salida:"
                                                       FontSize="11"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource SystemBaseMediumColor}" />
                                            <TimePicker SelectedTime="{Binding EndTime}"
                                                        MinuteIncrement="15" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Section 4: Rate Thresholds & Colors -->
                <Border BorderBrush="{DynamicResource SystemBaseLowColor}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Umbrales y Colores de Alerta"
                                   FontWeight="SemiBold"
                                   FontSize="14" />

                        <TextBlock Text="Personaliza los límites de horas de desfase y sus colores de insignia en la bandeja."
                                   FontSize="11"
                                   Foreground="{DynamicResource SystemBaseMediumColor}" />

                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" Margin="0,4,0,0">
                            <!-- Optimal threshold -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4" Margin="0,0,8,8">
                                <TextBlock Text="Margen Óptimo (horas):" FontSize="11" FontWeight="Medium" />
                                <NumericUpDown Value="{Binding OptimalMarginHours}"
                                               Minimum="0.1"
                                               Maximum="5.0"
                                               Increment="0.1"
                                               FormatString="{}{0:0.0} h" />
                            </StackPanel>

                            <!-- Rush threshold -->
                            <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4" Margin="8,0,0,8">
                                <TextBlock Text="Límite Ritmo Excesivo (horas):" FontSize="11" FontWeight="Medium" />
                                <NumericUpDown Value="{Binding HighRateMarginHours}"
                                               Minimum="1.0"
                                               Maximum="20.0"
                                               Increment="0.5"
                                               FormatString="{}{0:0.0} h" />
                            </StackPanel>

                            <!-- Color hex inputs -->
                            <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="*,*,*,*" Margin="0,4,0,0">
                                <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,4,0">
                                    <TextBlock Text="Óptimo (Verde)" FontSize="10" />
                                    <TextBox Text="{Binding ColorOptimalHex}" FontSize="11" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="2" Margin="2,0,2,0">
                                    <TextBlock Text="Rápido (Amarillo)" FontSize="10" />
                                    <TextBox Text="{Binding ColorWarningFastHex}" FontSize="11" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="2" Margin="2,0,2,0">
                                    <TextBlock Text="Excesivo (Rojo)" FontSize="10" />
                                    <TextBox Text="{Binding ColorDangerFastHex}" FontSize="11" />
                                </StackPanel>
                                <StackPanel Grid.Column="3" Spacing="2" Margin="4,0,0,0">
                                    <TextBlock Text="Lento (Azul)" FontSize="10" />
                                    <TextBox Text="{Binding ColorSlowHex}" FontSize="11" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Section 5: Telemetry & Grafana -->
                <Border BorderBrush="{DynamicResource SystemBaseLowColor}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Telemetría y Observabilidad (Grafana / OpenTelemetry)"
                                   FontWeight="SemiBold"
                                   FontSize="14" />

                        <TextBlock Text="Emite métricas, trazas y logs hacia Grafana Cloud o un recolector OTLP seguro con TLS."
                                   FontSize="11"
                                   Foreground="{DynamicResource SystemBaseMediumColor}" />

                        <CheckBox Content="Habilitar emisión de telemetría OpenTelemetry (OTLP)"
                                  IsChecked="{Binding TelemetryEnabled}"
                                  FontWeight="Medium"
                                  Margin="0,2,0,0" />

                        <StackPanel Spacing="8" IsEnabled="{Binding TelemetryEnabled}" Margin="0,4,0,0">
                            <StackPanel Spacing="3">
                                <TextBlock Text="Endpoint OTLP (HTTPS):" FontSize="11" FontWeight="Medium" />
                                <TextBox Text="{Binding TelemetryEndpoint}"
                                         PlaceholderText="https://otlp-gateway-prod-eu-west-0.grafana.net/otlp" />
                            </StackPanel>

                            <Grid ColumnDefinitions="*,*">
                                <StackPanel Grid.Column="0" Spacing="3" Margin="0,0,6,0">
                                    <TextBlock Text="Protocolo:" FontSize="11" FontWeight="Medium" />
                                    <TextBox Text="{Binding TelemetryProtocol}"
                                             PlaceholderText="HttpProtobuf o Grpc" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Spacing="3" Margin="6,0,0,0">
                                    <TextBlock Text="Nombre del Servicio:" FontSize="11" FontWeight="Medium" />
                                    <TextBox Text="{Binding TelemetryServiceName}"
                                             PlaceholderText="vsn-ai-rate-tracker" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Spacing="3">
                                <TextBlock Text="Cabeceras de Autorización (cifradas en almacén seguro):" FontSize="11" FontWeight="Medium" />
                                <TextBox Text="{Binding TelemetryHeaders}"
                                         PasswordChar="*"
                                         PlaceholderText="Authorization=Basic &lt;base64(instance:token)&gt;" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Section 6: Sync Settings -->
                <Border BorderBrush="{DynamicResource SystemBaseLowColor}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Sincronización en Segundo Plano"
                                   FontWeight="SemiBold"
                                   FontSize="14" />

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Frecuencia de actualización" FontSize="12" FontWeight="Medium" />
                                <TextBlock Text="Tiempo entre consultas al estado de la cuota" FontSize="11" Foreground="{DynamicResource SystemBaseMediumColor}" />
                            </StackPanel>
                            <NumericUpDown Grid.Column="1"
                                           Value="{Binding SyncIntervalMinutes}"
                                           Minimum="1"
                                           Maximum="60"
                                           FormatString="{}{0:0} min"
                                           VerticalAlignment="Center"
                                           Width="120" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer Buttons -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" Margin="0,16,0,0">
            <Button Grid.Column="1"
                    Content="Cancelar"
                    Width="100"
                    Margin="0,0,8,0"
                    Click="OnCancelClick" />
            <Button Grid.Column="2"
                    Content="Guardar"
                    Classes="accent"
                    Width="110"
                    Click="OnSaveClick" />
        </Grid>
    </Grid>
</Window>